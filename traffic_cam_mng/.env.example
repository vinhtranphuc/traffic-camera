# === Traffic Camera Management System ===

# Nginx
NGINX_PORT=80

# Database (MariaDB)
DB_ROOT_PASSWORD=root_secret
DB_NAME=trafficcam
DB_USER=trafficcam
DB_PASSWORD=trafficcam_secret
DB_PORT=3307

# Redis
REDIS_PASSWORD=redis_secret

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=trafficcam
MINIO_CONSOLE_PORT=9001

# Vault
VAULT_TOKEN=dev-root-token
VAULT_PORT=8200

# JWT (change in production!)
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_THIS_MUST_BE_AT_LEAST_32_CHARS

# Internal API Key (for AI service -> backend communication)
INTERNAL_API_KEY=internal_api_key_change_me
